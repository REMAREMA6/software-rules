{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-rules:schema:v1:capture",
  "title": "Software Rules capture",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "captureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "urn:software-rules:schema:v1:records#/$defs/target"
    },
    "scope": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "facetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "scenarioIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "description",
        "facetIds"
      ],
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "methodDescription": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/scenario"
      },
      "minItems": 0
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/execution"
      },
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/observation"
      },
      "minItems": 0
    },
    "runtimeRules": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/runtimeRule"
      },
      "minItems": 0
    },
    "sourceRules": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/sourceRule"
      },
      "minItems": 0
    },
    "declaredContracts": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/declaredContract"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/evidence"
      },
      "minItems": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "urn:software-rules:schema:v1:records#/$defs/coverageItem"
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "replicationScope": {
      "type": "object",
      "properties": {
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "propertyInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "propertyId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "facet": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "enum": [
                  "required",
                  "optional"
                ]
              },
              "status": {
                "enum": [
                  "captured",
                  "partial",
                  "not-observed",
                  "unknown",
                  "unavailable",
                  "conflicting",
                  "source-inferred",
                  "not-applicable",
                  "excluded"
                ]
              },
              "observationRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "uniqueItems": true
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "uniqueItems": true
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "exclusionReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "propertyId",
              "facet",
              "subject",
              "dimension",
              "requirement",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "captured",
                        "partial"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "observationRefs": {
                      "minItems": 1
                    },
                    "evidenceRefs": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "observationRefs",
                    "evidenceRefs"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "excluded"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "requirement": {
                      "const": "optional"
                    }
                  },
                  "required": [
                    "exclusionReason"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "not-observed",
                        "unknown",
                        "unavailable",
                        "conflicting",
                        "source-inferred",
                        "not-applicable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "rationale"
                  ]
                }
              }
            ]
          }
        },
        "completeness": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "incomplete",
                "undetermined"
              ]
            },
            "assessedAt": {
              "type": "string",
              "format": "date-time"
            },
            "assessmentMethod": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "assessedAt",
            "assessmentMethod",
            "rationale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scopeId",
        "description",
        "facets",
        "propertyInventory",
        "completeness"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "captureId",
    "createdAt",
    "purpose",
    "target",
    "scope",
    "collector",
    "coverage",
    "replicationScope"
  ],
  "additionalProperties": false
}

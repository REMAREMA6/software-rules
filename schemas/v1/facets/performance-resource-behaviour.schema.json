{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-rules:schema:v1:facets/performance-resource-behaviour",
  "title": "performance-resource-behaviour facet payload",
  "type": "object",
  "properties": {
    "facet": {
      "const": "performance-resource-behaviour"
    },
    "kind": {
      "const": "measurement"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "statistic": {
      "enum": [
        "min",
        "max",
        "mean",
        "median",
        "p50",
        "p90",
        "p95",
        "p99",
        "count",
        "rate",
        "sum",
        "other"
      ]
    },
    "measurementBoundary": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workload": {
      "type": "object"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 0
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "warmState": {
      "enum": [
        "cold",
        "warm",
        "mixed",
        "unknown"
      ]
    },
    "hardware": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "resourceScope": {
      "type": "string"
    },
    "collectionMethod": {
      "type": "string",
      "minLength": 1
    },
    "sampling": {
      "type": "string"
    },
    "uncertainty": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "facet",
    "kind",
    "subject"
  ],
  "additionalProperties": false
}

            "procedure": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string"
            },
            "toolVersion": {
              "type": "string"
            },
            "interface": {
              "type": "string"
            },
            "sampling": {
              "type": "string"
            },
            "observerEffects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "class",
            "procedure"
          ],
          "additionalProperties": false
        },
        "conditions": {
          "type": "object"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "urn:software-rules:schema:v1:facet-payloads"
        },
        "rawValue": {},
        "normalizedValue": {},
        "normalization": {
          "type": "object",
          "properties": {
            "procedure": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "sourceUnit": {
              "type": "string"
            },
            "targetUnit": {
              "type": "string"
            },
            "precision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "observed",
            "partial",
            "conflicting"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "observationId",
        "targetId",
        "facet",
        "subject",
        "method",
        "payload",
        "evidenceRefs",
        "status"

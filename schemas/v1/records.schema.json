          "type": "object"
        },
        "actualInitialState": {
          "$ref": "#/$defs/fieldState"
        },
        "actualInputs": {
          "type": "object"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0

        "value": {},
        "reason": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "coverageItem": {
      "type": "object",
      "properties": {

            "os": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "browser": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "$ref": "#/$defs/fieldState"

        "reachability": {
          "enum": [
            "established",
            "not-established",
            "unknown"
          ]
        },
        "buildInclusion": {
          "enum": [
            "established",
            "not-established",
            "unknown"
          ]
        },
        "deployment": {
          "enum": [
            "established",
            "not-established",
            "unknown"
          ]
        },
        "execution": {
          "enum": [
            "established",
            "not-established",
            "unknown"
          ]
        },
        "verificationState": {
          "enum": [
            "unverified",
            "runtime-supported",
            "runtime-contradicted",
            "superseded"
          ]

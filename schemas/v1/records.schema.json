        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "executionId",
        "scenarioId",
        "targetId",
        "startedAt",
        "status"
      ],
      "additionalProperties": false

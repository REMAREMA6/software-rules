        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "input": {},
              "expectedOutcomeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }

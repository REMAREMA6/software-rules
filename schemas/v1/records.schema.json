            "version": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "artifactDigest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "boundary": {
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
